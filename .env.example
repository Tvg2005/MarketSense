# Nivel de log da aplicacao
# Valores aceitos: debug (salva o HTML localmente para analise), ou deixe em branco para padrao
LOG_LEVEL=debug

# Chave secreta do Flask (opcional, gerada automaticamente se nao definida)
SECRET_KEY=

# URL de conexao com o PostgreSQL
DATABASE_URL=postgresql+psycopg://nfe_user:nfe_dev@localhost:5433/nfe_analyser
